/* Trailer Studio. Every color and size comes from the tokens below, so the tool can be re-themed here. */

.ts-root {
    /* Dark skin (the default). */
    --ts-bg: rgb(15, 22, 27);
    --ts-panel: rgb(25, 34, 40);
    --ts-raised: rgb(37, 49, 57);
    --ts-hover: rgb(49, 66, 75);
    --ts-line: rgb(65, 82, 91);
    --ts-text: rgb(238, 243, 241);
    --ts-dim: rgb(174, 190, 194);
    --ts-accent: rgb(119, 222, 204);
    --ts-accent-text: rgb(10, 35, 32);
    --ts-record: rgb(255, 128, 126);
    --ts-warn: rgb(255, 204, 123);
    --ts-good: rgb(148, 218, 162);
    --ts-viewport: rgb(11, 16, 20);
    --ts-selected: rgb(36, 66, 65);
    --ts-space-1: 4px;
    --ts-space-2: 8px;
    --ts-space-3: 12px;
    --ts-space-4: 16px;
    --ts-radius: 6px;
    --ts-font: 12px;
    --ts-font-small: 11px;
    --ts-font-large: 14px;

    flex-grow: 1;
    background-color: var(--ts-bg);
    color: var(--ts-text);
    font-size: var(--ts-font);
}

.ts-root.ts-light {
    --ts-selected: rgb(204, 230, 223);
    --ts-bg: rgb(225, 233, 232);
    --ts-panel: rgb(244, 248, 247);
    --ts-raised: rgb(255, 255, 255);
    --ts-hover: rgb(215, 232, 229);
    --ts-line: rgb(158, 177, 177);
    --ts-text: rgb(22, 41, 45);
    --ts-dim: rgb(63, 87, 94);
    --ts-accent: rgb(8, 99, 89);
    --ts-accent-text: rgb(255, 255, 255);
    --ts-record: rgb(161, 43, 54);
    --ts-warn: rgb(125, 72, 8);
    --ts-good: rgb(30, 98, 53);
    --ts-viewport: rgb(28, 38, 43);
}



/* ---- Top bar ---- */
.ts-topbar {
    flex-direction: row;
    align-items: center;
    height: 46px; flex-shrink: 0;
    padding: 0 var(--ts-space-3);
    background-color: var(--ts-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--ts-line);
}
.ts-spacer { flex-grow: 1; }
.ts-setpicker {
    height: 30px; min-width: 135px; max-width: 250px; overflow: hidden; text-overflow: ellipsis;
    padding: 0 var(--ts-space-3);
    font-size: var(--ts-font-large);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    background-color: var(--ts-raised);
    color: var(--ts-text);
    border-width: 0; border-radius: var(--ts-radius);
    margin: 0 var(--ts-space-3) 0 0;
}
.ts-setpicker:hover { background-color: var(--ts-hover); }
.ts-workflow {
    flex-shrink: 0;
    padding: 4px var(--ts-space-2);
    background-color: var(--ts-panel);
    border-bottom-width: 1px; border-bottom-color: var(--ts-line);
}
.ts-tabs { min-height: 44px; flex-direction: row; flex-wrap: wrap; }
.ts-tab Label { color: var(--ts-text); }
.ts-tab .ts-tab-caption { font-size: var(--ts-font-small); color: var(--ts-dim); }
.ts-tab--on Label, .ts-tab--on .ts-tab-caption { color: var(--ts-text); }
.ts-tab:focus, .ts-small:focus, .ts-big:focus, .ts-stage:focus {
    border-width: 1px; border-color: var(--ts-accent);
}
.ts-tab {
    height: 42px; min-width: 96px; flex-direction: row; align-items: center; justify-content: flex-start; padding: 0 var(--ts-space-3); margin: 0 2px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--ts-dim);
    border-width: 0; border-radius: var(--ts-radius);
    font-size: var(--ts-font-large);
}
.ts-tab:hover { background-color: var(--ts-hover); color: var(--ts-text); }
.ts-tab--on { border-bottom-width: 2px; border-bottom-color: var(--ts-accent); background-color: var(--ts-selected); color: var(--ts-text); -unity-font-style: bold; }
.ts-tab--on:hover { background-color: var(--ts-selected); color: var(--ts-text); }
.ts-chips { flex-direction: row; align-items: center; margin-right: var(--ts-space-2); }
.ts-chip {
    padding: 2px var(--ts-space-2); margin-left: var(--ts-space-1);
    border-radius: 10px; background-color: var(--ts-raised);
    color: var(--ts-dim); font-size: var(--ts-font-small);
}
.ts-chip--warn { color: var(--ts-warn); }
.ts-chip--good { color: var(--ts-good); }
.ts-chip--rec { color: var(--ts-record); -unity-font-style: bold; }
.ts-stage {
    height: 28px; padding: 0 var(--ts-space-3); margin: 0 var(--ts-space-1);
    background-color: var(--ts-raised); color: var(--ts-text);
    border-width: 0; border-radius: var(--ts-radius);
}
.ts-stage:hover { background-color: var(--ts-hover); }
.ts-record {
    flex-direction: row; align-items: center;
    height: 30px; max-width: 310px; overflow: hidden; padding: 0 var(--ts-space-3); margin: 0 var(--ts-space-2);
    background-color: var(--ts-raised);
    border-width: 1px; border-color: var(--ts-record); border-radius: 15px;
}
.ts-record:hover { background-color: var(--ts-hover); }
.ts-record:disabled { opacity: .45; }
.ts-record--on { background-color: var(--ts-record); }
.ts-record--on .ts-record-dot { background-color: rgb(255, 255, 255); }
.ts-record-dot { width: 10px; height: 10px; border-radius: 5px; background-color: var(--ts-record); margin-right: var(--ts-space-2); }
.ts-record-label { -unity-font-style: bold; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; color: var(--ts-text); }
.ts-record--on .ts-record-label { color: var(--ts-bg); }
.ts-record--on .ts-record-dot { background-color: var(--ts-bg); border-radius: 2px; }

/* ---- Buttons ---- */
.ts-small {
    height: 24px; padding: 0 var(--ts-space-2); margin: 0 2px;
    background-color: var(--ts-raised); color: var(--ts-text);
    border-width: 0; border-radius: var(--ts-radius);
    font-size: var(--ts-font-small);
}
.ts-small:hover { background-color: var(--ts-hover); }
.ts-small--on { background-color: var(--ts-accent); color: var(--ts-accent-text); }
.ts-small--on:hover { background-color: var(--ts-accent); }
.ts-round { width: 24px; padding: 0; border-radius: 12px; }
.ts-big {
    height: 34px; margin: var(--ts-space-1) 0; padding: 0 var(--ts-space-3);
    background-color: var(--ts-raised); color: var(--ts-text);
    border-width: 0; border-radius: var(--ts-radius);
    font-size: var(--ts-font-large); -unity-text-align: middle-left;
}
.ts-big:hover { background-color: var(--ts-hover); }
.ts-big--primary { background-color: var(--ts-accent); color: var(--ts-accent-text); -unity-font-style: bold; -unity-text-align: middle-center; }
.ts-big--primary:hover { background-color: var(--ts-accent); opacity: .9; }

/* ---- Middle: list, viewport, inspector ---- */
.ts-middle { flex-direction: row; flex-grow: 1; min-height: 160px; }
.ts-left {
    width: 240px; flex-shrink: 0;
    background-color: var(--ts-panel);
    border-right-width: 1px; border-right-color: var(--ts-line);
}
.ts-right {
    width: 310px; flex-shrink: 0;
    background-color: var(--ts-panel);
    border-left-width: 1px; border-left-color: var(--ts-line);
}
.ts-scroll { flex-grow: 1; }
.ts-heading {
    font-size: var(--ts-font-small); -unity-font-style: bold;
    color: var(--ts-dim);
    padding: var(--ts-space-3) var(--ts-space-3) var(--ts-space-1) var(--ts-space-3);
    letter-spacing: 1px;
}
.ts-hint { color: var(--ts-dim); white-space: normal; padding: var(--ts-space-1) 0; }
.ts-warning { color: var(--ts-warn); white-space: normal; padding: var(--ts-space-1) 0; }
.ts-mode-panel, .ts-inspector { padding: 0 var(--ts-space-3) var(--ts-space-3) var(--ts-space-3); }
.ts-card {
    background-color: var(--ts-raised);
    border-radius: var(--ts-radius);
    padding: var(--ts-space-2) var(--ts-space-3);
    margin: var(--ts-space-1) 0;
}
.ts-row { flex-direction: row; align-items: center; }
.ts-advanced { margin-top: var(--ts-space-2); }
.ts-advanced > Toggle Label { color: var(--ts-dim); }
.ts-field { margin: 2px 0; }
.ts-root .unity-base-field__label { color: var(--ts-dim); min-width: 84px; font-size: var(--ts-font-small); }
.ts-thumb { height: 120px; border-radius: var(--ts-radius); margin: var(--ts-space-1) 0; background-color: var(--ts-viewport); }

/* Cast list */
.ts-group { color: var(--ts-dim); padding: var(--ts-space-2) var(--ts-space-3) 2px var(--ts-space-3); font-size: var(--ts-font-small); }
.ts-item {
    flex-direction: row; align-items: center;
    height: 28px; padding: 0 var(--ts-space-2) 0 var(--ts-space-3); margin: 1px var(--ts-space-1);
    border-radius: var(--ts-radius);
}
.ts-item:hover { background-color: var(--ts-hover); }
.ts-item--selected { background-color: var(--ts-selected); border-left-width: 2px; border-left-color: var(--ts-accent); }
.ts-item-name { flex-grow: 1; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; }
.ts-dot { width: 10px; height: 10px; border-radius: 5px; margin-right: var(--ts-space-2); flex-shrink: 0; }
.ts-mini {
    width: 18px; height: 18px; padding: 0; margin: 0 1px;
    background-color: rgba(0, 0, 0, 0); color: var(--ts-dim);
    border-width: 0; border-radius: 4px; font-size: var(--ts-font-small);
}
.ts-mini:hover { background-color: var(--ts-hover); color: var(--ts-text); }
.ts-mini--on { background-color: var(--ts-accent); color: var(--ts-accent-text); }
.ts-take { color: var(--ts-dim); font-size: var(--ts-font-small); margin-right: 2px; }
.ts-badge {
    padding: 1px 6px; margin-left: var(--ts-space-1); border-radius: 8px;
    background-color: var(--ts-warn); color: var(--ts-bg); font-size: 10px;
}
.ts-empty { align-items: center; justify-content: center; flex-grow: 1; padding: var(--ts-space-4); }
.ts-empty-title { font-size: 18px; -unity-font-style: bold; margin-bottom: var(--ts-space-2); }
.ts-empty-text { color: var(--ts-dim); white-space: normal; -unity-text-align: middle-center; max-width: 420px; margin-bottom: var(--ts-space-3); }

/* Viewport */
.ts-viewport { flex-grow: 1; background-color: var(--ts-viewport); overflow: hidden; }
.ts-view-image { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ts-view-lines { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ts-view-help { background-color: rgba(12, 16, 24, .85); padding: 3px 6px; border-radius: 4px; white-space: normal; right: 8px; position: absolute; left: var(--ts-space-2); bottom: var(--ts-space-2); color: rgb(236, 240, 246); font-size: var(--ts-font-small); }
.ts-mark {
    position: absolute; width: 22px; height: 22px; margin-left: -11px; margin-top: -11px;
    border-radius: 11px; border-width: 2px; border-color: rgb(255, 255, 255);
    align-items: center; justify-content: center;
}
.ts-mark--selected { border-color: var(--ts-accent); border-width: 3px; }
.ts-mark-facing { position: absolute; width: 2px; height: 16px; top: -14px; background-color: rgb(255, 255, 255); }
.ts-mark-label {
    position: absolute; top: 22px; white-space: nowrap;
    color: rgb(255, 255, 255); font-size: var(--ts-font-small);
    background-color: rgba(0, 0, 0, .55); padding: 1px 5px; border-radius: 4px;
}
.ts-mark-label--warn { color: rgb(255, 211, 135); }

/* ---- Bottom: transport and timeline ---- */
.ts-bottom {
    height: 28%; min-height: 142px; max-height: 230px; flex-shrink: 0;
    background-color: var(--ts-panel);
    border-top-width: 1px; border-top-color: var(--ts-line);
}
.ts-transport { flex-direction: row; align-items: center; height: 34px; padding: 0 var(--ts-space-3); }
.ts-time { font-size: var(--ts-font-large); -unity-font-style: bold; margin: 0 var(--ts-space-3); min-width: 150px; }
.ts-timeline { flex-grow: 1; }
.ts-lane-filter { position: absolute; top: 0; left: 6px; width: 136px; height: 21px; -unity-text-align: middle-left; }
.ts-ruler { height: 22px; margin-left: 150px; border-bottom-width: 1px; border-bottom-color: var(--ts-line); }
.ts-lane-row { flex-direction: row; height: 24px; align-items: center; }
.ts-lane-row--selected { background-color: var(--ts-selected); }
.ts-lane-row:hover { background-color: var(--ts-hover); }
.ts-lane-name { width: 150px; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: var(--ts-space-3); overflow: hidden; }
.ts-lane { flex-grow: 1; height: 24px; }
.ts-playhead { position: absolute; top: 0; bottom: 0; width: 2px; margin-left: -1px; background-color: var(--ts-accent); }
.ts-footer { min-height: 26px; flex-direction: row; flex-wrap: wrap; align-items: center; background-color: var(--ts-bg); }
.ts-status {
    min-width: 140px; flex-basis: 0; flex-grow: 1; overflow: hidden; text-overflow: ellipsis; height: 24px; flex-shrink: 1; padding: 0 var(--ts-space-3);
    -unity-text-align: middle-left; color: var(--ts-dim); font-size: var(--ts-font-small);
    background-color: var(--ts-bg);
    border-top-width: 1px; border-top-color: var(--ts-line);
}

/* ---- Floating: command palette and shortcut sheet ---- */
.ts-floating { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; }
.ts-palette {
    margin-top: 62px; width: 480px; max-height: 72%;
    background-color: var(--ts-raised);
    border-width: 1px; border-color: var(--ts-accent); border-radius: 10px;
    padding: var(--ts-space-3);
}
.ts-palette-item { height: 26px; padding: 0 var(--ts-space-2); border-radius: var(--ts-radius); -unity-text-align: middle-left; }
.ts-palette-item:hover { background-color: var(--ts-hover); }
.ts-palette-item--on { background-color: var(--ts-accent); color: var(--ts-accent-text); }
.ts-sheet-row { flex-direction: row; margin: 2px 0; }
.ts-key {
    min-width: 96px; margin-right: var(--ts-space-3); padding: 1px 6px; border-radius: 4px;
    background-color: var(--ts-bg); color: var(--ts-text); font-size: var(--ts-font-small); -unity-text-align: middle-center;
}

/* Task navigation and selection use teal. Coral belongs to the recorder. */
.ts-mode-glyph { width: 18px; height: 18px; flex-shrink: 0; margin-right: 7px; color: var(--ts-dim); }
.ts-tab--on .ts-mode-glyph { color: var(--ts-accent); }
.ts-section-title {
    min-height: 32px; padding: 6px 12px; -unity-text-align: middle-left;
    font-size: 12px; color: var(--ts-text); background-color: var(--ts-bg);
    overflow: hidden; text-overflow: ellipsis; border-bottom-width: 1px; border-bottom-color: var(--ts-line);
}
.ts-section-title, .ts-group { -unity-font-style: bold; }
.ts-root .ts-warning { border-left-width: 2px; border-left-color: var(--ts-warn); padding-left: 7px; }
.ts-root .ts-card { border-left-width: 2px; border-left-color: var(--ts-line); }
.ts-record:focus, .ts-setpicker:focus, .ts-mini:focus, .ts-tab:focus, .ts-small:focus, .ts-big:focus, .ts-stage:focus {
    border-width: 1px; border-color: var(--ts-accent);
}
.ts-compact .ts-left { width: 192px; }
.ts-compact .ts-right { width: 276px; }
.ts-compact .ts-tab { min-width: 84px; padding: 0 6px; }
.ts-compact .ts-setpicker { min-width: 104px; max-width: 158px; }
.ts-compact .ts-record { max-width: 204px; }
.ts-compact .ts-time { min-width: 112px; margin: 0 6px; }
.ts-summary-title { color: var(--ts-text); -unity-font-style: bold; white-space: normal; }
.ts-row-meta { color: var(--ts-dim); font-size: var(--ts-font-small); }
.ts-duration-bar {
    height: 18px; min-height: 18px; margin: 4px 0; overflow: hidden;
    background-color: var(--ts-bg); border-radius: 3px; border-width: 1px; border-color: var(--ts-line);
}
.ts-duration-segment--divider { border-right-width: 1px; border-right-color: var(--ts-bg); }
.ts-duration-marker { background-color: var(--ts-text); }
.ts-duration-range { background-color: var(--ts-accent); }
.ts-ruler, .ts-lane { color: var(--ts-text); }

/* Keep editable text and popup values readable when previewing either palette. */
.ts-root .unity-text-field__input, .ts-root .unity-base-popup-field__input {
    color: var(--ts-text); background-color: var(--ts-bg);
    border-width: 1px; border-color: var(--ts-line); border-radius: 3px;
}
.ts-root .unity-base-popup-field__text, .ts-root .unity-foldout__text { color: var(--ts-text); }
.ts-root .unity-base-field__label { color: var(--ts-text); }
.ts-root .unity-text-field__input:focus, .ts-root .unity-base-popup-field__input:focus { border-color: var(--ts-accent); }
