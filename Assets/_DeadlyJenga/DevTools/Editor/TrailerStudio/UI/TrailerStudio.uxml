<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" class="ts-root">
        <ui:VisualElement name="topbar" class="ts-topbar">
            <ui:Button name="set-picker" class="ts-setpicker" tooltip="Choose, create or import a Set" />

            <ui:VisualElement class="ts-spacer" />

            <ui:Button name="stage" class="ts-stage" />
            <ui:Button name="record" class="ts-record">
                <ui:VisualElement name="record-dot" class="ts-record-dot" picking-mode="Ignore" />
                <ui:Label name="record-label" class="ts-record-label" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="commands" text="Find command" class="ts-small" tooltip="Search Studio actions (Ctrl+K)" />
            <ui:Button name="undo" text="Undo" class="ts-small" tooltip="Undo (Ctrl+Z)" />
            <ui:Button name="redo" text="Redo" class="ts-small" tooltip="Redo (Ctrl+Y)" />
            <ui:Button name="help" text="Shortcuts" class="ts-small" tooltip="Shortcuts (?)  ·  Commands (Ctrl+K)" />
        </ui:VisualElement>
        <ui:VisualElement class="ts-workflow">
            <ui:VisualElement name="tabs" class="ts-tabs" />
        </ui:VisualElement>
        <ui:VisualElement name="middle" class="ts-middle">
            <ui:VisualElement name="left" class="ts-left">
                <ui:Label text="Cast &amp; World" class="ts-heading ts-section-title" />
                <ui:ScrollView name="cast" class="ts-scroll" />
            </ui:VisualElement>
            <ui:VisualElement name="viewport" class="ts-viewport" />
            <ui:VisualElement name="right" class="ts-right">
                <ui:ScrollView name="side" class="ts-scroll">
                    <ui:VisualElement name="mode-panel" class="ts-mode-panel" />
                    <ui:Label name="inspector-heading" text="Set settings" class="ts-heading ts-section-title" />
                    <ui:VisualElement name="inspector" class="ts-inspector" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottom" class="ts-bottom">
            <ui:VisualElement name="transport" class="ts-transport" />
            <ui:VisualElement name="timeline" class="ts-timeline" />
        </ui:VisualElement>
        <ui:VisualElement class="ts-footer">
            <ui:VisualElement class="ts-feedback">
                <ui:Label name="selection-status" class="ts-feedback-label ts-selection-status" />
                <ui:Label name="last-pressed" class="ts-feedback-label ts-last-pressed" />
            </ui:VisualElement>
            <ui:VisualElement class="ts-footer-main">
                <ui:Label name="status" class="ts-status" />
                <ui:VisualElement name="chips" class="ts-chips" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="floating" class="ts-floating" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
