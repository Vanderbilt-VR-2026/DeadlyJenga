{
  "schemaVersion": 1,
  "id": "murder-mystery",
  "description": "Use own role, visibly drawn red blades and observed special strikes. Innocents flee visible threats and may repel at close contact; sheriffs confront observed threats. Pursue, report bodies, revive and recover badges through validated commands; never infer concealed private identities.",
  "objectives": [
    {
      "id": "survive",
      "query": "hazard-refuge",
      "skill": "Guard",
      "tier": 3,
      "personal": true,
      "maximum": 1,
      "radius": 0.7,
      "timeout": 30
    },
    {
      "id": "repel",
      "query": "close-threats",
      "skill": "Attack",
      "tier": 2,
      "personal": true,
      "maximum": 1,
      "utility": 3.5,
      "radius": 1.1,
      "timeout": 12,
      "retry": 2,
      "commitment": 1,
      "exclude": [
        "carrying"
      ]
    },
    {
      "id": "escape-witnessed",
      "query": "mystery-refuge",
      "skill": "Travel",
      "tier": 2,
      "personal": true,
      "maximum": 1,
      "utility": 2,
      "radius": 0.4,
      "timeout": 20
    },
    {
      "id": "pursue",
      "query": "mystery-attack",
      "skill": "Attack",
      "tier": 1,
      "maximum": 100,
      "utility": 1,
      "radius": 1,
      "timeout": 45
    },
    {
      "id": "revive",
      "query": "mystery-revive",
      "skill": "Guard",
      "completeWhen": "target-revived",
      "maximum": 1,
      "utility": 1.3,
      "radius": 0.65,
      "timeout": 30
    },
    {
      "id": "recover-badge",
      "query": "mystery-badge",
      "skill": "Guard",
      "completeWhen": "sheriff-promoted",
      "maximum": 1,
      "utility": 1.4,
      "radius": 0.65,
      "timeout": 30
    },
    {
      "id": "report",
      "query": "mystery-bodies",
      "skill": "Guard",
      "completeWhen": "body-reported",
      "maximum": 2,
      "utility": 0.8,
      "radius": 0.65,
      "timeout": 45
    },
    {
      "id": "explore",
      "query": "mystery-travel",
      "skill": "Travel",
      "completeWhen": "visited",
      "maximum": 4,
      "utility": 0.4,
      "radius": 0.8,
      "timeout": 45
    },
    {
      "id": "collect-equipment",
      "query": "pickups",
      "skill": "Travel",
      "interaction": "collect-pickup",
      "completeWhen": "pickup-collected",
      "tier": 0,
      "maximum": 1,
      "utility": 0.45,
      "radius": 1,
      "timeout": 25,
      "retry": 8,
      "commitment": 2,
      "exclude": [
        "carrying",
        "threat-near"
      ]
    }
  ]
}
