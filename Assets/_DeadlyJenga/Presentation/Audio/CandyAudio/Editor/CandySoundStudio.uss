.sound-studio { font-size: 13px; background-color: #17132b; color: #fff2da; }
.studio-header { flex-shrink: 0; min-height: 80px; padding: 16px 20px; background-color: #34234e; border-bottom-width: 3px; border-bottom-color: #6de2c2; }
.studio-title { min-height: 32px; flex-shrink: 0; font-size: 25px; -unity-font-style: bold; color: #fff1ce; margin-bottom: 4px; }
.sound-studio .unity-toolbar { flex-shrink: 0; height: auto; min-height: 34px; flex-wrap: wrap; background-color: #29203b; }
.sound-studio .unity-toolbar-button { color: #fff2da; min-height: 28px; padding-left: 10px; padding-right: 10px; }
.sound-studio .unity-button { background-color: #513566; color: #fff3dc; border-width: 1px; border-color: #86639c; border-radius: 7px; padding: 6px 10px; margin: 3px 3px 3px 0; white-space: normal; }
.sound-studio .unity-button:hover { background-color: #76518e; border-color: #91ffe0; }
.sound-studio .unity-button:active { background-color: #277d71; }
.search-row { flex-shrink: 0; min-height: 35px; flex-direction: row; align-items: center; padding: 8px 12px; }
.search-row .unity-toolbar-search-field { flex-grow: 1; margin-right: 12px; }
.studio-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.studio-sections { width: 195px; background-color: #251c37; padding: 8px; }
.studio-sections .unity-foldout__text { color: #90ead5; -unity-font-style: bold; }
.studio-sections .unity-foldout__content { margin-left: 5px; }
.studio-sections .section-button { -unity-text-align: middle-left; }
.studio-sounds { width: 280px; border-right-width: 1px; border-right-color: #513964; background-color: #1f1830; }
.sound-row { padding: 9px 10px; border-bottom-width: 1px; border-bottom-color: #3b2d4c; }
.sound-row .unity-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.studio-sounds .unity-collection-view__item--selected { background-color: #35565c; }
.studio-details { flex-grow: 1; min-width: 420px; padding: 14px; }
.studio-details .unity-label { white-space: normal; }
.detail-title { font-size: 22px; -unity-font-style: bold; color: #fff0c9; margin-bottom: 7px; }
.section-title { font-size: 14px; -unity-font-style: bold; color: #89edcf; margin-top: 16px; margin-bottom: 8px; }
.muted { color: #c4b6d2; font-size: 11px; }
.callout { background-color: #342943; padding: 12px; border-left-width: 3px; border-left-color: #71daca; margin: 10px 0; color: #f9e7ce; }
.button-row, .take-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 5px; }
.take-row .unity-object-field { flex-grow: 1; min-width: 180px; }
.source-line { font-size: 11px; color: #d2c6df; margin: 3px 0 10px 0; }
.studio-details .unity-base-field { margin-top: 4px; margin-bottom: 5px; }
.studio-details .unity-base-field__label { min-width: 125px; color: #efe2f5; }
.studio-details .unity-text-field__input, .studio-details .unity-base-popup-field__input { background-color: #342d46; color: #fff5e9; }
.studio-details .unity-foldout { margin-top: 12px; }
.studio-details .unity-foldout__text { color: #b2efdf; }
.studio-bottom { flex-shrink: 0; min-height: 36px; flex-direction: row; flex-wrap: wrap; align-items: center; padding: 6px 12px; background-color: #30243f; }
.studio-bottom .unity-toggle__text { color: #f2e4fa; }
.studio-status { flex-shrink: 0; min-height: 30px; padding: 9px 14px; color: #9debd6; background-color: #221b30; white-space: normal; }
.clip-library { height: 350px; min-height: 200px; background-color: #292239; }
